# Liga a camada de mocks (MSW + Socket.IO simulado). Obrigatório no demo publicado,
# já que não existe backend real.
VITE_ENABLE_MOCKS=true

# Base das chamadas REST (Axios). Com mocks, o MSW intercepta este caminho.
VITE_API_BASE_URL=/api

# Servidor Socket.IO. Com mocks, o MSW intercepta a conexão WebSocket para este host.
VITE_REALTIME_URL=wss://realtime.kurio.local
